# 复制为 .env.prod 后在服务器上填写真实值；不要提交 .env.prod

# Caddy/HTTPS：填写已解析到服务器的域名，例如 finance.example.com
APP_DOMAIN=finance.example.com
ACME_EMAIL=you@example.com

# 应用监听地址与 SQLite 数据库位置；Docker Compose 部署时一般不要改
SERVER_ADDR=:8787
DATABASE_PATH=/data/family.db
TZ=Asia/Shanghai

# 生产环境建议必填；访问页面时需要输入该 key
AUTH_KEY=

# AI 分类/财报分析，未配置时应用仍可启动，但 LLM 功能不可用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
