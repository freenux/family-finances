<view class="page">
  <view class="card">
    <view class="label">收支方向</view>
    <view>
      <text class="chip {{direction === d.value ? 'on' : ''}}" wx:for="{{directions}}" wx:for-item="d" wx:key="value" bindtap="setDirection" data-v="{{d.value}}">{{d.label}}</text>
    </view>

    <view class="label">金额（元）</view>
    <input class="input" type="digit" placeholder="0.00" value="{{amountYuan}}" bindinput="onAmount" />

    <view class="label">发生时间（不选则为现在）<text class="navbtn" wx:if="{{date || time}}" bindtap="clearTime">清除</text></view>
    <view class="row">
      <picker mode="date" value="{{date}}" bindchange="onDate"><view class="input pick">{{date || '默认现在'}}</view></picker>
      <picker mode="time" value="{{time}}" bindchange="onTime"><view class="input pick" style="margin-left:16rpx">{{time || '默认现在'}}</view></picker>
    </view>

    <view class="label">账户归属</view>
    <view>
      <text class="chip {{account === a.value ? 'on' : ''}}" wx:for="{{accounts}}" wx:for-item="a" wx:key="value" bindtap="setAccount" data-v="{{a.value}}">{{a.label}}</text>
    </view>

    <view class="label">分类</view>
    <view class="input pick" bindtap="openPicker">{{categoryName || '请选择分类'}}</view>

    <view class="label">对方</view>
    <input class="input" value="{{counterparty}}" bindinput="onField" data-k="counterparty" />
    <view class="label">说明</view>
    <input class="input" value="{{description}}" bindinput="onField" data-k="description" />
    <view class="label">备注</view>
    <input class="input" value="{{note}}" bindinput="onField" data-k="note" />
    <view class="label">成员</view>
    <input class="input" value="{{member}}" bindinput="onField" data-k="member" />
  </view>

  <button class="btn" bindtap="submit" disabled="{{saving}}">保存</button>

  <view class="mask" wx:if="{{picking}}" bindtap="closePicker">
    <view class="sheet" catchtap="noop">
      <view class="row" style="margin-bottom:12rpx">
        <text style="font-weight:600">选择分类</text>
        <text class="navbtn" bindtap="closePicker">取消</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <block wx:for="{{categories}}" wx:key="group_id" wx:for-item="g">
          <view class="g">{{g.group_name}}</view>
          <view class="opt" wx:for="{{g.items}}" wx:for-item="c" wx:key="id" bindtap="pick" data-id="{{c.id}}" data-name="{{c.name}}">{{c.name}}</view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
