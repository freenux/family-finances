/* 全局样式。尺寸换算：设计稿 750rpx 宽，1px = 2rpx。
   点击目标 >= 44px = 88rpx；输入框字号 >= 16px = 32rpx。 */
page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 30rpx;
  line-height: 1.5;
}
.page { padding: 24rpx 32rpx 48rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.btn {
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  background: #1a73e8;
  color: #fff;
  text-align: center;
}
.btn::after { border: none; }
.btn[disabled] { opacity: 0.5; }
.btn-ghost { background: #fff; color: #1a73e8; border: 2rpx solid #1a73e8; }
.btn-danger { background: #fff; color: #d93025; border: 2rpx solid #d93025; }
.input {
  min-height: 88rpx;
  font-size: 32rpx;
  padding: 0 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  box-sizing: border-box;
  width: 100%;
}
.label { font-size: 26rpx; color: #5f6368; margin: 20rpx 0 8rpx; }
.chip {
  display: inline-block;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #3c4043;
  border: 2rpx solid #dadce0;
  box-sizing: border-box;
}
.chip.on { background: #1a73e8; color: #fff; border-color: #1a73e8; }
.row { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #8a8f98; font-size: 26rpx; }
.empty { text-align: center; color: #8a8f98; padding: 80rpx 0; }
.warn { background: #fdecea; color: #b3261e; }
.ok { background: #e6f4ea; color: #137333; }
